{
  "version": 2,
  "builds": [
    { "src": "api/**/*.ts", "use": "@vercel/node" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/$1" }
  ],
  "functions": {
    "api/**/*.ts": { "runtime": "nodejs18.x", "maxDuration": 30 },
    "api/**/*.js": { "runtime": "nodejs18.x", "maxDuration": 30 }
  }
}
